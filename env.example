# Google Cloud Vision API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Copy this file to .env and add your actual API key

# For Expo/React Native, use EXPO_PUBLIC_ prefix for client-side access
EXPO_PUBLIC_OCR_API_KEY=your_google_cloud_vision_api_key_here

# Alternative: Use without EXPO_PUBLIC_ prefix (server-side only)
# OCR_API_KEY=your_google_cloud_vision_api_key_here

# Optional: App Configuration
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_DEBUG_MODE=false
